{
  "permissions": {
    "allow": [
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "mcp__review-mode-mcp__get_annotations",
      "mcp__review-mode-mcp__open_review",
      "mcp__review-mode-mcp__list_reviewed_files",
      "mcp__review-mode-mcp__update_annotation",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(grep *)",
      "Bash(awk NR==108,NR==112 { print NR\": \"$0 } *)",
      "mcp__notebooklm-mcp__notebook_list",
      "mcp__notebooklm-mcp__notebook_query",
      "mcp__review-mode-mcp__get_review_summary",
      "mcp__notebooklm-mcp__notebook_get",
      "Skill(source_registry)",
      "Skill(review-mode:implement-review)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true
  },
  "plansDirectory": "plans"
}

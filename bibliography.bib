@InBook{Bergstrom2013,
  author    = {Bergstr{\"o}m, Lars},
  booktitle = {Astrophysics at Very High Energies: Saas-Fee Advanced Course 40. Swiss Society for Astrophysics and Astronomy},
  title     = {Multi-Messenger Astronomy and Dark Matter},
  doi       = {10.1007/978-3-642-36134-0_2},
  isbn      = {978-3-642-36134-0},
  pages     = {123--222},
  publisher = {Springer Berlin Heidelberg},
  abstract  = {This chapter presents the elaborated lecture notes on Multi-Messenger Astronomy and Dark Matter given by Lars Bergstr{\"o}m at the 40th Saas-Fee Advanced Course on ``Astrophysics at Very High Energies''. One of the main problems of astrophysics and astro-particle physics is that the nature of dark matter remains unsolved. There are basically three complementary approaches to try to solve this problem. One is the detection of new particles with accelerators, the second is the observation of various types of messengers from radio waves to gamma-ray photons and neutrinos, and the third is the use of ingenious experiments for direct detection of dark matter particles. After giving an introduction to the particle universe, the author discusses the relic density of particles, basic cross sections for neutrinos and gamma-rays, supersymmetric dark matter, detection methods for neutralino dark matter, particular dark matter candidates, the status of dark matter detection, a detailed calculation on an hypothetical ``Saas-Fee Wimp'', primordial black holes, and gravitational waves.},
  address   = {Berlin, Heidelberg},
  year      = {2013},
}

